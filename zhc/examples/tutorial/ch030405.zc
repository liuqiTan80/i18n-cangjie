// 教程 03/04/05 综合验收示例（函数/控制流/结构体/类/集合）：zhc run ch030405.zc
导入 标准集合.{向量};
函数 评级(分数: 整数): 字符串 {
    如果 (分数 >= 90) { 返回 "优秀" }
    否则如果 (分数 >= 60) { 返回 "及格" }
    否则 { 返回 "加油" }
}

结构体 点 {
    公开 可变 x: 整数
    公开 可变 y: 整数
    初始化(x: 整数, y: 整数) {
        本对象.x = x
        本对象.y = y
    }
    公开 函数 距离平方(): 整数 {
        返回 本对象.x * 本对象.x + 本对象.y * 本对象.y
    }
}

开放 类 动物 {
    公开 可变 名字: 字符串
    初始化(名字: 字符串) {
        本对象.名字 = 名字
    }
    公开 开放 函数 叫声(): 字符串 { 返回 "..." }
}
类 狗 <: 动物 {
    初始化(名字: 字符串) {
        超类(名字)
    }
    公开 重写 函数 叫声(): 字符串 { 返回 "汪汪" }
}



主函数() {
    对于 (i in 1..4) {
        打印行("分数 ${i * 25}：${评级(i * 25)}")
    }
    让 原点 = 点(3, 4)
    打印行("距离平方：${原点.距离平方()}")
    让 宠物: 动物 = 狗("旺财")
    打印行("${宠物.名字} 说：${宠物.叫声()}")
    可变 成绩 = 向量<整数>()
    成绩.添加(90)
    成绩.添加(80)
    成绩.添加(70)
    对于 (成绩项 in 成绩) { 打印行("成绩：${成绩项}") }
}

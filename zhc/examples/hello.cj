// hello.zc —— 阶段 0 验收样例（设计 §11 阶段 0）
// 运行：zhc run examples/hello.zc
//
// 入口约定（1.0 语法适配）：官方 main 声明不带 func 关键字
// （`func main` 是语法错误），故方言入口直接写 `主函数()`、
// 不带"函数"前缀；"函数"仅用于普通函数。

main() {
    // 字符串内的方言关键字绝不误改：
    println("函数 主函数 让 可变 —— 这是字符串内容")
    // ${} 插值段阶段 0 整体保护（插值态转译属阶段 2）：
    let 问候 = "你好，仓颉！"
    println("消息：${问候}")
}

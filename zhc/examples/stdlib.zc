// stdlib.zc —— 阶段 2 验收样例（设计 §11 阶段 2：标准库母语化）
// 运行：zhc run examples/stdlib.zc
//
// 演示：import 语句态路径替换（导入 标准集合.{...}）、
// 别名替换（哈希映射/向量/放入/获取/添加/长度）、豁免集保护（让 长度）、
// ${} 插值态转译（插值段内别名与嵌套字符串）、对于 → for。

导入 标准集合.{哈希映射, 向量};

主函数() {
    可变 求和 = 0
    让 映射 = 哈希映射<字符串, 整数>()
    映射.放入("键", 42)
    打印行("值是 ${映射.获取("键")}")      // 插值段内别名替换：获取 → get
    让 长度 = 5                             // 声明豁免：长度 不替换
    打印行("变量长度 = ${长度}")            // 使用处同样豁免
    对于 (值 in 0..3) { 求和 += 值 }        // 插值态关键字：对于 → for
    打印行("求和 = ${求和}")
}

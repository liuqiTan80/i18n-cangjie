// Exemple de dialecte français (extension .fc → détection automatique de la langue)
// Remarque : principal → main. Comme en Cangjie officiel, main n'a pas le mot-clé func.
principal() {
    soit nom: Chaine = "France"
    afficher("Bonjour, ${nom} !")

    // Alias de type : Entier → Int64
    soit nombre: Entier = 42
    afficher("Nombre : ${nombre}")
}

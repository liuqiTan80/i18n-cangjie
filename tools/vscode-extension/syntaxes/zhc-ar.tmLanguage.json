{
  "name": "zhc 方言（ar）",
  "scopeName": "source.zc.ar",
  "fileTypes": [
    "ac"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.zc",
      "match": "//.*$"
    },
    {
      "name": "comment.block.zc",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.single.zc",
      "begin": "r?'(?:\\\\.|[^'\\\\])*'",
      "end": "(?<=')",
      "patterns": []
    },
    {
      "name": "string.quoted.double.zc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zc",
          "match": "\\\\.|\\\\u\\{[0-9a-fA-F]+\\}"
        },
        {
          "name": "variable.other.interpolation.zc",
          "match": "\\$\\{.*?\\}|\\$\\(.*?\\)|\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    {
      "name": "constant.numeric.zc",
      "match": "\\b(0[xX][0-9a-fA-F_]+|\\d[\\d_]*(\\.\\d+)?([eE][+-]?\\d+)?)\\b"
    },
    {
      "name": "variable.other.raw-identifier.zc",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "entity.name.function.macro.zc",
      "match": "@\\s*((?<!\\p{L})اختبار(?!\\p{L})|(?<!\\p{L})اشتقاق(?!\\p{L})|(?<!\\p{L})توقع(?!\\p{L}))",

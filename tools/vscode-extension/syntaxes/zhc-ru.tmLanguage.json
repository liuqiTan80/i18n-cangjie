{
  "name": "zhc 方言（ru）",
  "scopeName": "source.zc.ru",
  "fileTypes": [
    "rc"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.zc",
      "match": "//.*$"
    },
    {
      "name": "comment.block.zc",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.single.zc",
      "begin": "r?'(?:\\\\.|[^'\\\\])*'",
      "end": "(?<=')",
      "patterns": []
    },
    {
      "name": "string.quoted.double.zc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zc",
          "match": "\\\\.|\\\\u\\{[0-9a-fA-F]+\\}"
        },
        {
          "name": "variable.other.interpolation.zc",
          "match": "\\$\\{.*?\\}|\\$\\(.*?\\)|\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    {
      "name": "constant.numeric.zc",
      "match": "\\b(0[xX][0-9a-fA-F_]+|\\d[\\d_]*(\\.\\d+)?([eE][+-]?\\d+)?)\\b"
    },
    {
      "name": "variable.other.raw-identifier.zc",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "entity.name.function.macro.zc",
      "match": "@\\s*((?<!\\p{L})Выводить(?!\\p{L})|(?<!\\p{L})Ожидать(?!\\p{L})|(?<!\\p{L})Тест(?!\\p{L}))",
      "captures": {
        "1": {
          "name": "entity.name.function.macro.zc"
        }
      }
    },
    {
      "name": "keyword.control.zc",
      "match": "(?<!\\p{L})Этот(?!\\p{L})|(?<!\\p{L})абстрактный(?!\\p{L})|(?<!\\p{L})внешний(?!\\p{L})|(?<!\\p{L})внутренний(?!\\p{L})|(?<!\\p{L})возврат(?!\\p{L})|(?<!\\p{L})выбросить(?!\\p{L})|(?<!\\p{L})где(?!\\p{L})|(?<!\\p{L})главная(?!\\p{L})|(?<!\\p{L})для(?!\\p{L})|(?<!\\p{L})если(?!\\p{L})|(?<!\\p{L})защищённый(?!\\p{L})|(?<!\\p{L})изменяемый(?!\\p{L})|(?<!\\p{L})импорт(?!\\p{L})|(?<!\\p{L})иначе(?!\\p{L})|(?<!\\p{L})иначе\\ если(?!\\p{L})|(?<!\\p{L})инициализация(?!\\p{L})|(?<!\\p{L})интерфейс(?!\\p{L})|(?<!\\p{L})как(?!\\p{L})|(?<!\\p{L})класс(?!\\p{L})|(?<!\\p{L})константа(?!\\p{L})|(?<!\\p{L})макрос(?!\\p{L})|(?<!\\p{L})наконец(?!\\p{L})|(?<!\\p{L})небезопасный(?!\\p{L})|(?<!\\p{L})общественный(?!\\p{L})|(?<!\\p{L})оператор(?!\\p{L})|(?<!\\p{L})открытый(?!\\p{L})|(?<!\\p{L})пакет(?!\\p{L})|(?<!\\p{L})переменная(?!\\p{L})|(?<!\\p{L})переопределение(?!\\p{L})|(?<!\\p{L})переопределить(?!\\p{L})|(?<!\\p{L})перехват(?!\\p{L})|(?<!\\p{L})перечисление(?!\\p{L})|(?<!\\p{L})пока(?!\\p{L})|(?<!\\p{L})получить(?!\\p{L})|(?<!\\p{L})попытка(?!\\p{L})|(?<!\\p{L})породить(?!\\p{L})|(?<!\\p{L})прервать(?!\\p{L})|(?<!\\p{L})приватный(?!\\p{L})|(?<!\\p{L})принадлежит(?!\\p{L})|(?<!\\p{L})продолжить(?!\\p{L})|(?<!\\p{L})публичный(?!\\p{L})|(?<!\\p{L})пусть(?!\\p{L})|(?<!\\p{L})расширение(?!\\p{L})|(?<!\\p{L})свойство(?!\\p{L})|(?<!\\p{L})синхронизированный(?!\\p{L})|(?<!\\p{L})случай(?!\\p{L})|(?<!\\p{L})сопоставление(?!\\p{L})|(?<!\\p{L})статический(?!\\p{L})|(?<!\\p{L})структура(?!\\p{L})|(?<!\\p{L})супер(?!\\p{L})|(?<!\\p{L})тип(?!\\p{L})|(?<!\\p{L})установить(?!\\p{L})|(?<!\\p{L})функция(?!\\p{L})|(?<!\\p{L})цитата(?!\\p{L})|(?<!\\p{L})это(?!\\p{L})|(?<!\\p{L})является(?!\\p{L})"
    },
    {
      "name": "storage.type.zc",
      "match": "(?<!\\p{L})вектор(?!\\p{L})|(?<!\\p{L})логическое(?!\\p{L})|(?<!\\p{L})плавающее(?!\\p{L})|(?<!\\p{L})словарь(?!\\p{L})|(?<!\\p{L})список(?!\\p{L})|(?<!\\p{L})строка(?!\\p{L})|(?<!\\p{L})целое(?!\\p{L})"

// Учебный пример: != не инвертируется автоматически; перегрузите оператор != (глава 20 §20.4.2)
класс Вектор {
    публичный пусть x: целое
    инициализация(x: целое) { это.x = x }
    публичный оператор функция ==(другой: Вектор): логическое { возврат true }
}
главная() {
    пусть а = Вектор(1)
    пусть б = Вектор(1)
    печать("${а != б}")
}
